{{!
    @template tool_murules/rule_cards

    Overview WHEN→THEN rule cards with status filters (Bootstrap / Moodle native).
}}
<div class="tool_murules-overview">
    {{#killswitch}}
        <div class="alert alert-warning" role="alert">
            <strong>{{#str}} killswitch_banner_title, tool_murules {{/str}}</strong>
            {{#str}} killswitch_banner, tool_murules {{/str}}
            <a class="alert-link" href="{{settingsurl}}">{{#str}} killswitch_banner_link, tool_murules {{/str}}</a>
        </div>
    {{/killswitch}}
    {{#observersoff}}
        <div class="alert alert-info" role="alert">
            <strong>{{#str}} observersoff_banner_title, tool_murules {{/str}}</strong>
            {{#str}} observersoff_banner, tool_murules {{/str}}
            <a class="alert-link" href="{{settingsurl}}">{{#str}} killswitch_banner_link, tool_murules {{/str}}</a>
        </div>
    {{/observersoff}}
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <nav aria-label="{{#str}} filter_label, tool_murules {{/str}}">
            <ul class="nav nav-pills flex-wrap gap-1">
                {{#filters}}
                    <li class="nav-item">
                        <a class="nav-link{{#selected}} active{{/selected}}" href="{{url}}" {{#selected}}aria-current="page"{{/selected}}>
                            {{label}} <span class="badge text-bg-light text-dark">{{count}}</span>
                        </a>
                    </li>
                {{/filters}}
            </ul>
        </nav>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a class="btn btn-link btn-sm" href="{{settingsurl}}">{{#str}} settings, tool_murules {{/str}}</a>
            <a class="btn btn-primary" href="{{createurl}}">{{#str}} createrule, tool_murules {{/str}}</a>
        </div>
    </div>
    {{#hasrules}}
        <form class="d-flex flex-wrap align-items-center gap-2 mb-3" method="get" action="{{searchaction}}" role="search">
            {{#filtervalue}}
                <input type="hidden" name="filter" value="{{filtervalue}}">
            {{/filtervalue}}
            <label class="visually-hidden" for="tool_murules_search_q">{{#str}} searchrules, tool_murules {{/str}}</label>
            <input id="tool_murules_search_q" class="form-control" style="max-width: 18rem;" type="search" name="q" value="{{query}}"
                   placeholder="{{#str}} searchrules_placeholder, tool_murules {{/str}}" autocomplete="off"
                   {{#hasquery}}autofocus{{/hasquery}} aria-describedby="tool_murules_search_hint">
            <button class="btn btn-secondary" type="submit">{{#str}} search {{/str}}</button>
            {{#hasquery}}
                <a class="btn btn-link btn-sm" href="{{clearurl}}">{{#str}} clearsearch, tool_murules {{/str}}</a>
            {{/hasquery}}
            <span id="tool_murules_search_hint" class="visually-hidden">{{#str}} searchrules_hint, tool_murules {{/str}}</span>
        </form>
    {{/hasrules}}
    {{^hasrules}}
        <div class="alert alert-secondary" role="status">
            <h3 class="h5 alert-heading">{{#str}} norules_title, tool_murules {{/str}}</h3>
            <p class="mb-2">{{#str}} norules, tool_murules {{/str}}</p>
            <a class="btn btn-primary" href="{{createurl}}">{{#str}} createrule, tool_murules {{/str}}</a>
        </div>
    {{/hasrules}}
    {{#hasrules}}
        {{#filterempty}}
            <div class="alert alert-secondary" role="status">
                <h3 class="h5 alert-heading">{{#str}} filter_empty_title, tool_murules {{/str}}</h3>
                <p class="mb-2">{{#str}} filter_empty, tool_murules {{/str}}</p>
                <a class="btn btn-secondary btn-sm" href="{{createurl}}">{{#str}} createrule, tool_murules {{/str}}</a>
            </div>
        {{/filterempty}}
        {{#hasvisible}}
            <p class="text-muted small mb-2" aria-live="polite">{{resultcount}}</p>
            <div class="accordion tool_murules-cards" id="tool_murules_rules_accordion" role="list">
                {{#rules}}
                    {{> tool_murules/rule_card}}
                {{/rules}}
            </div>
        {{/hasvisible}}
    {{/hasrules}}
</div>
